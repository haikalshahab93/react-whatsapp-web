# Environment configuration for backend
NODE_ENV=development
APP_ORIGIN=http://localhost:3001
# MONGO_URI can be left default if you use local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_web_clone

# JWT secret for issuing tokens (development only)
JWT_SECRET=change_me_dev_secret

# Twilio WhatsApp credentials (fill with your real values)
# Get these from https://www.twilio.com/console and WhatsApp Sandbox page
TWILIO_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
# For Sandbox, use the Twilio WhatsApp sandbox number, e.g. +14155238886
TWILIO_WHATSAPP_FROM=+14155238886

# SMTP configuration for invitation emails (Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=you@example.com

# Twilio WhatsApp configuration (from number must be a Twilio-approved WhatsApp sender)
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# App origin used in invitation links
# APP_ORIGIN=http://your-domain.com